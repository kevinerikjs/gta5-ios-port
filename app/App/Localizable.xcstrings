          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Encontramos a pasta do jogo, mas ela ainda não pode ser usada. Toque para ver o motivo e como corrigir."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Папка игры найдена, но её пока нельзя использовать. Нажмите, чтобы узнать причину и как это исправить."
          }
        },
        "zh-Hans": {
          "stringUnit": {
