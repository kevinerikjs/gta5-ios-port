    "Include my latest save (game progress only, about 0.5 MB), so the developer can load the game where it happened": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Include my latest save (game progress only, about 0.5 MB), so the developer can load the game where it happened"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Meinen letzten Spielstand mitsenden (nur Spielfortschritt, etwa 0,5 MB), damit der Entwickler das Spiel an dieser Stelle laden kann"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Incluir mi última partida guardada (solo el progreso del juego, unos 0,5 MB) para que el desarrollador pueda cargar el juego donde ocurrió"
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Incluir mi última partida guardada (solo el progreso del juego, unos 0.5 MB) para que el desarrollador pueda cargar el juego donde pasó"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Joindre ma dernière sauvegarde (progression du jeu uniquement, environ 0,5 Mo) pour que le développeur puisse charger la partie là où c'est arrivé"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Includi il mio ultimo salvataggio (solo i progressi di gioco, circa 0,5 MB), così lo sviluppatore può caricare la partita dove è successo"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最新のセーブデータを含める（ゲームの進行状況のみ、約0.5 MB）。開発者が問題の起きた場所からゲームを読み込めます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "최신 저장 파일 포함(게임 진행 상황만, 약 0.5MB). 개발자가 문제가 생긴 지점에서 게임을 불러올 수 있습니다"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dołącz mój ostatni zapis (tylko postęp w grze, około 0,5 MB), aby twórca mógł wczytać grę w miejscu, w którym to się stało"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Incluir meu último jogo salvo (só o progresso do jogo, cerca de 0,5 MB) para o desenvolvedor carregar o jogo onde aconteceu"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Приложить моё последнее сохранение (только прогресс игры, около 0,5 МБ), чтобы разработчик мог загрузить игру там, где это случилось"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "附上我最新的存档（仅游戏进度，约 0.5 MB），方便开发者从出问题的地方载入游戏"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "附上我最新的存檔（僅遊戲進度，約 0.5 MB），方便開發者從出問題的地方載入遊戲"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Включи последното ми запазване (само напредъка на играта, около 0.5 МБ), за да може да види разработчика къде е станало"
          }
        }
      }
    },
