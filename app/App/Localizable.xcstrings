    "Type an amount for the character you're playing. Handy if the old $0 bug took yours.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Type an amount for the character you're playing. Handy if the old $0 bug took yours."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib einen Betrag für die Figur ein, die du spielst. Praktisch, wenn dir der alte $0-Fehler dein Geld genommen hat."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escribe una cantidad para el personaje que estás usando. Útil si el antiguo fallo de $0 te dejó sin dinero."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Escribe una cantidad para el personaje que estás usando. Útil si el viejo error de $0 te dejó sin dinero."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisissez un montant pour le personnage que vous jouez. Pratique si l’ancien bug des 0 $ a pris le vôtre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scrivi un importo per il personaggio che stai usando. Utile se il vecchio bug dei $0 ti ha tolto i soldi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "操作中のキャラクターの金額を入力します。以前の「$0になる不具合」でお金を失った場合に便利です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "플레이 중인 캐릭터의 금액을 입력합니다. 예전의 $0 버그로 돈을 잃었다면 유용합니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wpisz kwotę dla postaci, którą grasz. Przydatne, jeśli stary błąd $0 zabrał ci pieniądze."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Digite um valor para o personagem que você está jogando. Útil se o antigo bug do $0 levou o seu dinheiro."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Введите сумму для персонажа, за которого вы играете. Пригодится, если старая ошибка с $0 обнулила ваши деньги."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为你当前操控的角色输入金额。如果旧的 $0 错误清空了你的钱，这很有用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "為你目前操控的角色輸入金額。如果舊的 $0 錯誤清空了你的錢，這很有用。"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Siz oʻynayotgan qahramon uchun pul miqdorini kiriting. Eski $0 bug'i pulingizni nolga tushirib qoʻygan boʻlsa, juda qoʻl keladi."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Напиши количество за героя, който играеш. Удобно ако стария бъг за 0$ все твоите."
          }
        }
      }
    },
    "The money of the character you're playing (Michael, Franklin or Trevor) becomes this amount. Save the game to keep it.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The money of the character you're playing (Michael, Franklin or Trevor) becomes this amount. Save the game to keep it."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Geld der Figur, die du spielst (Michael, Franklin oder Trevor), wird auf diesen Betrag gesetzt. Speichere das Spiel, um es zu behalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El dinero del personaje que estás usando (Michael, Franklin o Trevor) pasa a ser esta cantidad. Guarda la partida para conservarlo."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "El dinero del personaje que estás usando (Michael, Franklin o Trevor) pasa a ser esta cantidad. Guarda la partida para conservarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’argent du personnage que vous jouez (Michael, Franklin ou Trevor) devient ce montant. Sauvegardez la partie pour le garder."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I soldi del personaggio che stai usando (Michael, Franklin o Trevor) diventano questo importo. Salva la partita per mantenerli."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "操作中のキャラクター（マイケル、フランクリン、トレバー）の所持金がこの金額になります。残すにはゲームをセーブしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "플레이 중인 캐릭터(마이클, 프랭클린, 트레버)의 돈이 이 금액이 됩니다. 유지하려면 게임을 저장하세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pieniądze postaci, którą grasz (Michael, Franklin lub Trevor), zmienią się na tę kwotę. Zapisz grę, żeby je zachować."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O dinheiro do personagem que você está jogando (Michael, Franklin ou Trevor) passa a ser este valor. Salve o jogo para mantê-lo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Деньги персонажа, за которого вы играете (Майкл, Франклин или Тревор), станут этой суммой. Сохраните игру, чтобы они остались."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你当前操控的角色（麦克、富兰克林或崔佛）的金钱会变为此金额。保存游戏即可保留。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你目前操控的角色（麥可、富蘭克林或崔佛）的金錢會變為此金額。儲存遊戲即可保留。"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Siz oʻynayotgan qahramonning (Maykl, Franklin yoki Trevor) puli ushbu miqdorga oʻzgaradi. Pulni saqlab qolish uchun oʻyinni saqlang (save qiling)."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Парите на героя, който играеш (Майкъл, Франклин или Тревър) стават толкова. Запази играта за да ги задържиш."
          }
        }
      }
    },
