        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu servidor do jogo não responde"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваш игровой сервер не отвечает"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Máy chủ trò chơi của bạn không phản hồi"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
