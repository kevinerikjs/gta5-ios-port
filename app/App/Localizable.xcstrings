        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Субтитри над началната лента."
          }
        }
      }
    },
    "Raises the subtitle line a little, so the home bar doesn't cover it. Applies the next time the game starts.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Raises the subtitle line a little, so the home bar doesn't cover it. Applies the next time the game starts."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hebt die Untertitelzeile etwas an, damit die Home-Leiste sie nicht verdeckt. Gilt ab dem nächsten Spielstart."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sube un poco la línea de subtítulos para que la barra de inicio no la tape. Se aplica la próxima vez que inicies el juego."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Sube un poco la línea de subtítulos para que la barra de inicio no la tape. Se aplica la próxima vez que inicies el juego."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Remonte un peu la ligne des sous-titres pour que la barre d’accueil ne la cache pas. S’applique au prochain lancement du jeu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Alza un po’ la riga dei sottotitoli, così la barra Home non la copre. Vale dal prossimo avvio del gioco."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "字幕の行を少し上げ、ホームバーで隠れないようにします。次にゲームを起動したときに適用されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자막 줄을 조금 올려 홈 바에 가려지지 않게 합니다. 다음에 게임을 시작할 때 적용됩니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Podnosi trochę linię napisów, żeby pasek główny jej nie zasłaniał. Działa od następnego uruchomienia gry."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sobe um pouco a linha das legendas, para a barra de início não cobri-la. Vale na próxima vez que o jogo iniciar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Немного поднимает строку субтитров, чтобы полоска «Домой» её не закрывала. Применяется при следующем запуске игры."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把字幕行稍微上移，免得被主屏幕指示条挡住。下次启动游戏时生效。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "把字幕行稍微上移，免得被主畫面指示條擋住。下次啟動遊戲時生效。"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Вдига субтитрите малко, за да не ги закрива началната лента. Прилага се следващия път като играта стартира."
          }
        }
      }
    },
