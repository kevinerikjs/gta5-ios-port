    "Touch and hold the button to hold the key. Move or resize it in Settings › Edit controls layout.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Touch and hold the button to hold the key. Move or resize it in Settings › Edit controls layout."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Halte den Button gedrückt, um die Taste zu halten. Verschieben oder Größe ändern unter Einstellungen › Steuerung bearbeiten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén pulsado el botón para mantener la tecla. Muévelo o cambia su tamaño en Ajustes › Editar controles."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén presionado el botón para mantener la tecla. Muévelo o cambia su tamaño en Configuración › Editar controles."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Maintenez le bouton pour maintenir la touche. Déplacez-le ou redimensionnez-le dans Paramètres › Modifier les commandes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tieni premuto il pulsante per tenere premuto il tasto. Spostalo o ridimensionalo in Impostazioni › Modifica comandi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ボタンを押し続けるとキーを押し続けます。移動やサイズ変更は「設定 › 操作配置を編集」で。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "버튼을 길게 누르면 키를 계속 누릅니다. 이동이나 크기 조절은 설정 › 컨트롤 배치 편집에서 하세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przytrzymaj przycisk, aby trzymać klawisz. Przesuń go lub zmień rozmiar w Ustawienia › Edytuj sterowanie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Segure o botão para segurar a tecla. Mova ou redimensione em Configurações › Editar controles."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удерживайте кнопку, чтобы держать клавишу. Переместить или изменить размер: Настройки › Изменить управление."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按住按钮即按住按键。可在“设置 › 编辑按键布局”中移动或调整大小。"
          }
        },
