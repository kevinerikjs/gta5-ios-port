    "One tap. Helps fix crashes and loading problems": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One tap. Helps fix crashes and loading problems"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "回報閃退與載入問題，協助開發者排查"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un seul geste. Aide à corriger les plantages et problèmes de chargement"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un tocco. Aiuta a risolvere crash e problemi di caricamento"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Tippen. Hilft, Abstürze und Ladeprobleme zu beheben"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un toque. Ayuda a solucionar cierres y problemas de carga"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ワンタップ。クラッシュや読み込みの問題の修正に役立ちます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한 번만 탭하세요. 충돌 및 로드 문제 해결에 도움이 됩니다"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jedno stuknięcie. Pomaga naprawiać awarie i problemy z wczytywaniem"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um toque. Ajuda a corrigir travamentos e problemas de carregamento"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Одно нажатие. Помогает исправить вылеты и проблемы с загрузкой"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
