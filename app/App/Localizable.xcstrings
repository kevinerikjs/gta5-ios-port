    "Found your game folder, but it can't be used yet. Tap to see why and how to fix it.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Found your game folder, but it can't be used yet. Tap to see why and how to fix it."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已找到遊戲資料夾，但目前無法使用。點按查看原因及修復方式。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dossier du jeu trouvé, mais pas encore utilisable. Touchez pour savoir pourquoi et comment corriger."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
