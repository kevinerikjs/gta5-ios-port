    "Too late to call: the mission fails. Retry, and call Jay Norris between 1:17 and 2:50.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Too late to call: the mission fails. Retry, and call Jay Norris between 1:17 and 2:50."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zu spät zum Anrufen: Die Mission schlägt fehl. Versuch es erneut und ruf Jay Norris zwischen 1:17 und 2:50 an."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Demasiado tarde para llamar: la misión falla. Reinténtalo y llama a Jay Norris entre 1:17 y 2:50."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Demasiado tarde para llamar: la misión falla. Reinténtalo y llama a Jay Norris entre 1:17 y 2:50."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trop tard pour appeler : la mission échoue. Réessayez et appelez Jay Norris entre 1:17 et 2:50."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Troppo tardi per chiamare: la missione fallisce. Riprova e chiama Jay Norris tra 1:17 e 2:50."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "電話するには遅すぎます: ミッション失敗です。リトライして、1:17から2:50の間にJay Norrisに電話してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전화하기에 너무 늦었습니다: 미션 실패입니다. 다시 시도해 1:17에서 2:50 사이에 Jay Norris에게 전화하세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Za późno na telefon: misja się nie uda. Spróbuj ponownie i zadzwoń do Jaya Norrisa między 1:17 a 2:50."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tarde demais para ligar: a missão falha. Tente de novo e ligue para Jay Norris entre 1:17 e 2:50."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Звонить уже поздно: миссия провалена. Повторите и позвоните Джею Норрису между 1:17 и 2:50."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "来不及打了：任务会失败。重试，并在 1:17 到 2:50 之间给 Jay Norris 打电话。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "來不及打了：任務會失敗。重試，並在 1:17 到 2:50 之間打給 Jay Norris。"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Занадто пізно для дзвінку: місія провалиться. Спробуйте ще раз, і подзвоніть Джею Норрісу між 13:17 та 14:50."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Qoʻngʻiroq qilishga kechikdingiz: topshiriq muvaffaqiyatsiz yakunlandi. Qaytadan urinib koʻring va Jey Norrisga 1:17 va 2:50 oraligʻida qoʻngʻiroq qiling."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ако прекалено късно се обадиш: мисията се проваля. Опитай отново и се обади на Джей Норис между 1:17 и 2:50"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aramak için çok geç: görev başarısız. Tekrar deneyin ve Jay Norris'i 1:17 ile 2:50 arasında arayın."
          }
        }
      }
    },
