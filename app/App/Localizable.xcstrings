    "Get in a car to make a button for that car only. Buttons show while script mods run.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Get in a car to make a button for that car only. Buttons show while script mods run."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Steig in ein Auto, um einen Button nur für dieses Auto zu machen. Buttons erscheinen, solange Script-Mods laufen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Súbete a un coche para crear un botón solo para ese coche. Los botones se muestran mientras funcionan los mods de script."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Súbete a un auto para crear un botón solo para ese auto. Los botones se muestran mientras funcionan los mods de script."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Montez dans une voiture pour créer un bouton propre à cette voiture. Les boutons s’affichent tant que des mods de script tournent."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sali su un’auto per creare un pulsante solo per quell’auto. I pulsanti compaiono mentre le mod script sono attive."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "車に乗ると、その車専用のボタンを作れます。ボタンはスクリプト Mod の実行中に表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "차에 타면 그 차 전용 버튼을 만들 수 있습니다. 버튼은 스크립트 모드가 실행 중일 때 표시됩니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wsiądź do auta, aby zrobić przycisk tylko dla niego. Przyciski są widoczne, gdy działają mody skryptowe."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Entre em um carro para criar um botão só para esse carro. Os botões aparecem enquanto mods de script estão rodando."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сядьте в машину, чтобы сделать кнопку только для неё. Кнопки видны, пока работают скриптовые моды."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "坐进一辆车，即可创建仅限该车的按钮。按钮在脚本模组运行时显示。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "坐進一輛車，即可建立僅限該車的按鈕。按鈕在腳本模組執行時顯示。"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Влезте в превозно средство, за да създадете бутон, предназначен само за него. Бутоните се показват, докато работят скрипт модове."
          }
        }
      }
    },
    "Buttons show while script mods run.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Buttons show while script mods run."
