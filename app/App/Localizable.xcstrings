    "Vehicles are unavailable. Return to gameplay, then reopen this menu.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Vehicles are unavailable. Return to gameplay, then reopen this menu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fahrzeuge sind nicht verfügbar. Kehre ins Spiel zurück und öffne dieses Menü dann erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los vehículos no están disponibles. Vuelve al juego y luego abre este menú otra vez."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Los vehículos no están disponibles. Vuelve al juego y luego abre este menú otra vez."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les véhicules ne sont pas disponibles. Revenez au jeu, puis rouvrez ce menu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I veicoli non sono disponibili. Torna al gioco, poi riapri questo menu."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "車両を利用できません。ゲームに戻ってから、このメニューを開き直してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "차량을 사용할 수 없습니다. 게임으로 돌아간 뒤 이 메뉴를 다시 여세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pojazdy są niedostępne. Wróć do gry, a potem otwórz to menu ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os veículos não estão disponíveis. Volte ao jogo e abra este menu de novo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Транспорт недоступен. Вернитесь в игру, затем снова откройте это меню."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "载具不可用。请回到游戏，然后重新打开此菜单。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "載具無法使用。請回到遊戲，然後重新開啟此選單。"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Transportlar mavjud emas. O‘yinga qayting, so‘ng ushbu menyuni qayta oching."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Превозните средства не са налични. Върни се в играта, след това отвори това меню отново."
          }
        }
      }
    },
