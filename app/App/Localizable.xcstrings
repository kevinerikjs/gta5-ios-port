    "Looking through every folder inside for your game, then checking each file.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Looking through every folder inside for your game, then checking each file."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Recherche du jeu dans tous les sous-dossiers, puis vérification de chaque fichier."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cerco il gioco in tutte le cartelle interne, poi controllo ogni file."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle Unterordner werden nach deinem Spiel durchsucht, danach wird jede Datei geprüft."
          }
        },
        "es": {
