      }
    },
    "Paused because this Mac is almost out of storage.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم الإيقاف المؤقت لأن مساحة التخزين على جهاز Mac هذا توشك على النفاد."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pausiert, weil der Speicher dieses Mac fast voll ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Paused because this Mac is almost out of storage."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En pausa porque este Mac casi no tiene almacenamiento libre."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "En pausa porque esta Mac casi no tiene almacenamiento libre."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En pause : ce Mac n’a presque plus de stockage."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In pausa perché questo Mac ha quasi esaurito lo spazio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このMacのストレージがほぼいっぱいのため、一時停止しました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Mac의 저장 공간이 거의 가득 차서 일시 정지되었습니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wstrzymano, bo na tym Macu prawie zabrakło miejsca."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pausado porque o armazenamento deste Mac está quase cheio."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пауза: на этом Mac почти не осталось места."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã tạm dừng vì máy Mac này sắp hết dung lượng lưu trữ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac 存储空间即将用完，已暂停下载。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac 儲存空間即將耗盡，已暫停下載。"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "На пауза, защото този Mac е почти без пространство за съхранение."
          }
        }
      }
    },
    "The app was not allowed to open that folder. Choose it again, or choose a folder above it.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يُسمح للتطبيق بفتح هذا المجلد. اختره مرة أخرى، أو اختر مجلدًا أعلى منه."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die App durfte diesen Ordner nicht öffnen. Wähle ihn erneut oder wähle einen übergeordneten Ordner."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app was not allowed to open that folder. Choose it again, or choose a folder above it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La app no tiene permiso para abrir esa carpeta. Vuelve a elegirla o elige una carpeta que la contenga."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "La app no tiene permiso para abrir esa carpeta. Vuelve a elegirla o elige una carpeta que la contenga."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’app n’a pas été autorisée à ouvrir ce dossier. Choisissez-le à nouveau, ou choisissez un dossier qui le contient."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’app non ha il permesso di aprire quella cartella. Sceglila di nuovo, oppure scegli una cartella superiore."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリにそのフォルダを開く許可がありませんでした。もう一度選択するか、その上位のフォルダを選択してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱에 해당 폴더를 열 수 있는 권한이 없습니다. 폴더를 다시 선택하거나 그 상위 폴더를 선택하세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikacja nie otrzymała dostępu do tego folderu. Wybierz go ponownie lub wybierz folder nadrzędny."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O app não teve permissão para abrir essa pasta. Escolha-a de novo ou escolha uma pasta acima dela."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Приложению не разрешили открыть эту папку. Выберите её снова или выберите папку выше неё."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ứng dụng không được phép mở thư mục đó. Hãy chọn lại, hoặc chọn một thư mục cấp trên của nó."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "App 没有权限访问此文件夹。请重新选择它，或选择它上层的文件夹。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "App 沒有權限讀取此資料夾。請重新選擇它，或選擇它上層的資料夾。"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Не е позволено на приложението да отваря тази папка. Избери я отново, или избери друга папка над нея."
          }
        }
      }
    },
    "There is no game in \"{arg0}\". Choose the folder that has your game in it. Any folder above it works too: the app searches everything inside.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا توجد لعبة في \"{arg0}\". اختر المجلد الذي يحتوي على لعبتك. أي مجلد أعلى منه يعمل أيضًا: يبحث التطبيق في كل ما بداخله."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In „{arg0}“ ist kein Spiel. Wähle den Ordner, in dem dein Spiel liegt. Jeder übergeordnete Ordner geht auch: Die App durchsucht alles darin."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There is no game in \"{arg0}\". Choose the folder that has your game in it. Any folder above it works too: the app searches everything inside."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay ningún juego en \"{arg0}\". Elige la carpeta que contiene tu juego. También sirve cualquier carpeta superior: la app busca en todo su contenido."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay ningún juego en \"{arg0}\". Elige la carpeta que contiene tu juego. También sirve cualquier carpeta superior: la app busca en todo su contenido."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il n’y a aucun jeu dans « {arg0} ». Choisissez le dossier qui contient votre jeu. N’importe quel dossier au-dessus convient aussi : l’app cherche dans tout son contenu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non c’è nessun gioco in “{arg0}”. Scegli la cartella che contiene il gioco. Va bene anche qualsiasi cartella superiore: l’app cerca in tutto il contenuto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「{arg0}」にゲームがありません。ゲームが入っているフォルダを選んでください。その上位のフォルダでもかまいません。アプリが中をすべて検索します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "‘{arg0}’에 게임이 없습니다. 게임이 들어 있는 폴더를 선택하세요. 그 상위 폴더도 괜찮습니다. 앱이 그 안을 모두 검색합니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "W „{arg0}” nie ma gry. Wybierz folder, w którym jest gra. Zadziała też każdy folder nadrzędny: aplikacja przeszuka całą jego zawartość."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não há jogo em \"{arg0}\". Escolha a pasta que contém o seu jogo. Qualquer pasta acima dela também serve: o app procura em tudo lá dentro."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В «{arg0}» нет игры. Выберите папку с игрой. Подойдёт и любая папка выше неё: приложение проверит всё внутри."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không có game nào trong \"{arg0}\". Hãy chọn thư mục chứa game của bạn. Thư mục cấp trên nào cũng được: ứng dụng sẽ tìm trong mọi thứ bên trong."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“{arg0}”中没有游戏。请选择包含游戏的文件夹。它上层的任一文件夹也可以：App 会搜索其中的所有内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「{arg0}」中沒有遊戲。請選擇含有遊戲的資料夾。它上層的任一資料夾也可以：App 會搜尋其中所有內容。"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Няма игра в “{arg0}”. Избери папката, която има играта ти в нея. Всяка папка над нея работи също: приложението търси всички вътре."
          }
        }
      }
    },
    "For Macs with little memory: lower detail and draw distance, so the world keeps loading": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لأجهزة Mac ذات الذاكرة القليلة: تفاصيل ومسافة رسم أقل، حتى يستمر تحميل العالم"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für Macs mit wenig Speicher: weniger Details und Sichtweite, damit die Welt weiter lädt"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For Macs with little memory: lower detail and draw distance, so the world keeps loading"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para Mac con poca memoria: menos detalle y distancia de dibujado, para que el mundo siga cargando"
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Para Mac con poca memoria: menos detalle y distancia de dibujado, para que el mundo siga cargando"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour les Mac avec peu de mémoire : moins de détails et de distance d’affichage, pour que le monde continue de se charger"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per Mac con poca memoria: meno dettagli e distanza visiva, così il mondo continua a caricarsi"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メモリが少ないMac向け：詳細と描画距離を下げ、ワールドの読み込みを続けます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "메모리가 적은 Mac용: 디테일과 시야 거리를 낮춰 월드가 계속 로드됩니다"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dla Maców z małą ilością pamięci: mniej szczegółów i krótszy zasięg widzenia, by świat dalej się wczytywał"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para Macs com pouca memória: menos detalhes e distância de visão, para o mundo continuar carregando"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для Mac с малым объёмом памяти: меньше деталей и дальности прорисовки, чтобы мир продолжал загружаться"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cho máy Mac ít RAM: giảm chi tiết và tầm nhìn xa, để thế giới tiếp tục tải được"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "适用于内存较小的 Mac：降低细节和绘制距离，让世界持续加载"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "適用於記憶體較小的 Mac：降低細節與繪製距離，讓世界持續載入"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "За Mac модели с по-ниска памет: по-ниски детайли и дистанция на изобразяване, така че светът продължава да се зарежда."
          }
        }
      }
    },
