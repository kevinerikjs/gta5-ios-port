    "Experimental. Keeps the ground and roads from turning grey after long play. Turn off if the game runs out of memory.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Experimental. Keeps the ground and roads from turning grey after long play. Turn off if the game runs out of memory."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Experimentell. Verhindert, dass Boden und Straßen nach langem Spielen grau werden. Ausschalten, wenn dem Spiel der Speicher ausgeht."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Experimental. Evita que el suelo y las carreteras se vuelvan grises tras jugar mucho rato. Desactívalo si el juego se queda sin memoria."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Experimental. Evita que el suelo y las carreteras se vuelvan grises tras jugar mucho rato. Desactívalo si el juego se queda sin memoria."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Expérimental. Empêche le sol et les routes de devenir gris après une longue partie. Désactivez si le jeu manque de mémoire."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sperimentale. Evita che terreno e strade diventino grigi dopo tanto gioco. Disattivalo se il gioco esaurisce la memoria."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "試験的機能。長時間プレイしても地面や道路がグレーになるのを防ぎます。メモリ不足になる場合はオフにしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "실험적 기능. 오래 플레이해도 땅과 도로가 회색으로 변하지 않게 합니다. 게임 메모리가 부족해지면 끄세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Eksperymentalne. Zapobiega szarzeniu ziemi i dróg po długiej grze. Wyłącz, jeśli grze brakuje pamięci."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Experimental. Evita que o chão e as ruas fiquem cinza depois de jogar muito tempo. Desligue se o jogo ficar sem memória."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Экспериментально. Не даёт земле и дорогам становиться серыми после долгой игры. Выключите, если игре не хватает памяти."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "实验性功能。防止长时间游玩后地面和道路变成灰色。如果游戏内存不足，请关闭。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "實驗性功能。防止長時間遊玩後地面和道路變成灰色。如果遊戲記憶體不足，請關閉。"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Експериментално. Пази земята или улиците от това да станат сиви след дълга игра. Изключи го, ако на телефона паметта свърши."
          }
        }
      }
    },
