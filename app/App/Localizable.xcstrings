    "The game files are already on this iPhone (folder \"{arg0}\"), so nothing needs downloading.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The game files are already on this iPhone (folder \"{arg0}\"), so nothing needs downloading."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "遊戲檔案已存於此 iPhone（資料夾「{arg0}」），無須再次下載。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les fichiers du jeu sont déjà sur cet iPhone (dossier « {arg0} »), rien à télécharger."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
