    "Situational changes the buttons with what you're doing. Controller buttons shows every Xbox controller button, all the time.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Situational changes the buttons with what you're doing. Controller buttons shows every Xbox controller button, all the time."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Situationsabhängig zeigt die Tasten für das, was du gerade tust. Controller-Tasten zeigt immer alle Tasten eines Xbox-Controllers."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Según la situación cambia los botones según lo que hagas. Botones del mando muestra todos los botones de un mando de Xbox, siempre."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Según la situación cambia los botones según lo que hagas. Botones del control muestra todos los botones de un control de Xbox, siempre."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Selon la situation change les boutons selon ce que vous faites. Boutons de manette affiche tous les boutons d’une manette Xbox, en permanence."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In base alla situazione cambia i tasti a seconda di ciò che fai. Tasti del controller mostra sempre tutti i tasti di un controller Xbox."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "状況に合わせる：していることに応じてボタンが変わります。コントローラのボタン：Xbox コントローラの全ボタンを常に表示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "상황에 맞게: 하고 있는 일에 따라 버튼이 바뀝니다. 컨트롤러 버튼: Xbox 컨트롤러의 모든 버튼을 항상 표시합니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zależny od sytuacji zmienia przyciski zależnie od tego, co robisz. Przyciski kontrolera pokazuje zawsze wszystkie przyciski kontrolera Xbox."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Conforme a situação muda os botões de acordo com o que você está fazendo. Botões do controle mostra todos os botões de um controle Xbox, o tempo todo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«По ситуации» меняет кнопки в зависимости от того, что вы делаете. «Кнопки геймпада» всегда показывает все кнопки геймпада Xbox."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "随情境变化：按键随你正在做的事而变。手柄按键：始终显示 Xbox 手柄的全部按键。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "隨情境變化：按鍵隨你正在做的事而變。手把按鍵：一律顯示 Xbox 手把的全部按鍵。"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ситуационно променя бутоните в зависимост какво правиш. Бутоните за контролер винаги показват всеки Xbox бутон за котролер, през цялото време"
          }
        }
      }
    },
