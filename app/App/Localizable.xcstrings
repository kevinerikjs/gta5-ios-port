        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chặn quảng cáo đang tắt cho trang này. Nhấp lại vào nút tải về trên trang."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已对此网站关闭广告拦截。请再次点按网页上的下载按钮。"
          }
