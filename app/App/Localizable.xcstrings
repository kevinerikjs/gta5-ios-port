    "Press ⓐ to talk. Help messages show here.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Press ⓐ to talk. Help messages show here."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط ⓐ للتحدث. تظهر رسائل المساعدة هنا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Drücke ⓐ zum Reden. Hilfetexte erscheinen hier."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pulsa ⓐ para hablar. Los mensajes de ayuda aparecen aquí."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Presiona ⓐ para hablar. Los mensajes de ayuda aparecen aquí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appuyez sur ⓐ pour parler. Les messages d’aide s’affichent ici."
