        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pakiet add-on „{arg0}” potrzebuje pliku, którego nie zawiera. Zainstaluj moda ponownie lub wyłącz go w Ustawienia › Mody."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O pacote add-on \"{arg0}\" precisa de um arquivo que não inclui. Instale o mod de novo ou desative-o em Configurações › Mods."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Аддон-пакету «{arg0}» нужен файл, которого в нём нет. Переустановите мод или отключите его в Настройки › Моды."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "附加包“{arg0}”需要一个它没有包含的文件。请重新安装该模组，或在“设置 › 模组”中关闭它。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
