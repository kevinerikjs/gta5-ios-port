{
  "sourceLanguage": "en",
  "strings": {
    "\n\nThe game now starts at its usual resolution": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\nThe game now starts at its usual resolution"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\n現在改用一般解析度啟動"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\nLe jeu démarre désormais à sa résolution habituelle"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\nOra il gioco si avvia alla risoluzione abituale"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\nDas Spiel startet jetzt in seiner üblichen Auflösung"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\nAhora el juego se inicia con su resolución habitual"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\n今後、ゲームは通常の解像度で起動します"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\n이제 게임이 기본 해상도로 시작됩니다"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\nGra uruchomi się teraz w zwykłej rozdzielczości"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\nAgora o jogo inicia na resolução normal"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\nТеперь игра запускается в обычном разрешении"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\n现在改用常规分辨率启动"
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\nAhora el juego se inicia con su resolución16 habitual"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\nGame sẽ chạy ở độ phân giải thông thường"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\nاللعبة تبدأ الأن بدقتها الأصلية"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\nOʻyin endi odatiy oʻlchamda boshlanadi"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\nГра запуститься зі звичайною роздільною здатністю"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\nOyun artık her zamanki çözünürlüğünde başlıyor"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\nИграта сега стартира на нормалното качество"
          }
        }
      }
    },
