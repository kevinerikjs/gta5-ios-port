    "The game can't use a mod that is still packed. Tap one to install it.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The game can't use a mod that is still packed. Tap one to install it."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن للعبة استخدام تعديل لا يزال مضغوطًا. اضغط على أحدها لتثبيته."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Spiel kann einen noch gepackten Mod nicht nutzen. Tippe auf einen, um ihn zu installieren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El juego no puede usar un mod que sigue comprimido. Toca uno para instalarlo."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "El juego no puede usar un mod que sigue comprimido. Toca uno para instalarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le jeu ne peut pas utiliser un mod encore compressé. Touchez-en un pour l’installer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il gioco non può usare una mod ancora compressa. Toccane una per installarla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "圧縮されたままの MOD はゲームで使えません。タップしてインストールしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "압축된 채로 있는 모드는 게임에서 쓸 수 없습니다. 탭해서 설치하세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gra nie może użyć moda, który jest nadal spakowany. Stuknij, aby go zainstalować."
