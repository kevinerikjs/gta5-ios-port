    "That isn't a GTA V Story save. Story saves are files named like SGTA50000, about 0.5 MB.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That isn't a GTA V Story save. Story saves are files named like SGTA50000, about 0.5 MB."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das ist kein GTA V Story-Spielstand. Story-Spielstände heißen etwa SGTA50000 und sind etwa 0,5 MB groß."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Eso no es una partida de la historia de GTA V. Se llaman como SGTA50000 y ocupan unos 0,5 MB."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Eso no es una partida de la historia de GTA V. Se llaman como SGTA50000 y pesan unos 0,5 MB."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce n’est pas une sauvegarde de l’histoire de GTA V. Elles s’appellent comme SGTA50000 et font environ 0,5 Mo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è un salvataggio della storia di GTA V. Si chiamano tipo SGTA50000 e pesano circa 0,5 MB."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "GTA Vのストーリーのセーブではありません。セーブはSGTA50000のような名前で、約0.5 MBです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "GTA V 스토리 저장 파일이 아닙니다. 저장 파일은 SGTA50000 같은 이름이며 약 0.5 MB입니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To nie jest zapis fabuły GTA V. Zapisy nazywają się jak SGTA50000 i mają około 0,5 MB."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso não é um save do modo história do GTA V. Os saves têm nomes como SGTA50000 e cerca de 0,5 MB."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это не сохранение сюжета GTA V. Такие файлы называются вроде SGTA50000 и весят около 0,5 МБ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这不是 GTA V 故事模式存档。存档文件名类似 SGTA50000，大约 0.5 MB。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這不是 GTA V 故事模式存檔。存檔檔名類似 SGTA50000，大約 0.5 MB。"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu GTA V hikoya rejimidagi saqlanma fayli emas. Hikoya rejimidagi saqlanmalar SGTA50000 kabi nomlanadi va hajmi taxminan 0,5 MB bo‘ladi."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Това не е GTA V запазване на история. Запазванията на история са файлове с име като SGTA50000, около 0,5 МБ."
          }
        }
      }
    },
    "All 15 save slots are in use. Delete a save in the game (Pause › Game › Load Game) or in Files, then try again.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All 15 save slots are in use. Delete a save in the game (Pause › Game › Load Game) or in Files, then try again."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle 15 Speicherplätze sind belegt. Lösche einen Spielstand im Spiel (Pause › Spiel › Spiel laden) oder in Dateien und versuche es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los 15 huecos están ocupados. Borra una partida en el juego (Pausa › Juego › Cargar partida) o en Archivos e inténtalo de nuevo."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Los 15 espacios están ocupados. Borra una partida en el juego (Pausa › Juego › Cargar partida) o en Archivos e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les 15 emplacements sont pris. Supprimez une sauvegarde dans le jeu (Pause › Jeu › Charger une partie) ou dans Fichiers, puis réessayez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutti i 15 slot sono occupati. Elimina un salvataggio nel gioco (Pausa › Gioco › Carica partita) o in File, poi riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "15個のスロットがすべて使用中です。ゲーム内（ポーズ › ゲーム › ゲームをロード）か「ファイル」でセーブを削除してからやり直してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "15개 슬롯이 모두 사용 중입니다. 게임(일시 정지 › 게임 › 게임 불러오기)이나 파일 앱에서 저장 파일을 지운 뒤 다시 시도하세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wszystkie 15 miejsc jest zajętych. Usuń zapis w grze (Pauza › Gra › Wczytaj grę) albo w Plikach i spróbuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os 15 espaços estão ocupados. Apague um save no jogo (Pausa › Jogo › Carregar jogo) ou no Arquivos e tente de novo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Все 15 слотов заняты. Удалите сохранение в игре (Пауза › Игра › Загрузить игру) или в «Файлах» и попробуйте снова."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "15 个存档位都已占用。请在游戏中（暂停 › 游戏 › 读取游戏）或“文件”中删除一个存档后再试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "15 個存檔位都已占用。請在遊戲中（暫停 › 遊戲 › 讀取遊戲）或「檔案」中刪除一個存檔後再試。"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Barcha 15 ta saqlash sloti band. O‘yin ichida (Pauza › O‘yin › O‘yinni yuklash) yoki Fayllar ilovasida saqlangan o‘yinlardan birini o‘chirib tashlang va qayta urinib ko‘ring."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Всички 15 слота за запазване се използват. Изтрий запазване в играта (Пауза > Game > Load Game) или във Файлове/Files, и опитай отново."
          }
        }
      }
    },
