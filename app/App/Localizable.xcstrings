          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã tìm thấy thư mục game, nhưng hiện ko thể sử dụng. Ấn để xem lý do và cách xử lý."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
