          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In LiveContainer liegt der Ordner dieser App in LiveContainers eigenem Ordner in Dateien, nicht direkt in Auf meinem iPhone: „GTA V Port-Ordner öffnen“ bringt dich hin."
