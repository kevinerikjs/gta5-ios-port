    " Close and reopen the app to play {arg0}.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": " Close and reopen the app to play {arg0}."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": " 關閉再重新開啟 App，即可進入 {arg0}。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": " Fermez et rouvrez l’app pour jouer en {arg0}."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": " Chiudi e riapri l’app per giocare con {arg0}."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": " Schließe die App und öffne sie erneut, um {arg0} zu spielen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": " Cierra y vuelve a abrir la app para jugar en {arg0}."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": " {arg0}をプレイするには、アプリを閉じて再度開いてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": " {arg0}을(를) 플레이하려면 앱을 닫았다가 다시 여세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": " Zamknij i ponownie otwórz aplikację, aby zagrać w: {arg0}."
          }
        },
        "pt-BR": {
