    "MetalFX brings the picture to the screen's resolution with sharpening instead of stretching it. Uses a little more battery.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "MetalFX brings the picture to the screen's resolution with sharpening instead of stretching it. Uses a little more battery."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "MetalFX bringt das Bild mit Schärfung auf die Auflösung des Bildschirms, statt es zu strecken. Braucht etwas mehr Akku."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "MetalFX lleva la imagen a la resolución de la pantalla con nitidez en lugar de estirarla. Usa un poco más de batería."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "MetalFX lleva la imagen a la resolución de la pantalla con nitidez en lugar de estirarla. Usa un poco más de batería."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "MetalFX amène l’image à la résolution de l’écran avec un renforcement de la netteté au lieu de l’étirer. Consomme un peu plus de batterie."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "MetalFX porta l’immagine alla risoluzione dello schermo con nitidezza invece di allungarla. Usa un po’ più di batteria."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "MetalFXが画像を引き伸ばす代わりに、シャープにして画面の解像度に合わせます。バッテリーを少し多く使います。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "MetalFX가 화면을 늘리는 대신 선명하게 하여 화면 해상도로 맞춥니다. 배터리를 조금 더 사용합니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "MetalFX doprowadza obraz do rozdzielczości ekranu z wyostrzaniem zamiast go rozciągać. Zużywa trochę więcej baterii."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O MetalFX leva a imagem à resolução da tela com nitidez em vez de esticá-la. Usa um pouco mais de bateria."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "MetalFX доводит изображение до разрешения экрана с повышением резкости вместо растягивания. Расходует немного больше заряда."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "MetalFX 会把画面锐化并提升到屏幕分辨率，而不是直接拉伸。会稍微多耗一点电。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "MetalFX 會把畫面銳化並提升到螢幕解析度，而不是直接拉伸。會稍微多耗一點電。"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "MetalFX tasvirni shunchaki choʻzib qoʻymasdan, uni oʻtkirlashtirish orqali ekran ruxsatiga yetkazadi. Biroq biroz koʻproq batareya sarflaydi."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "MetalFX докарва картината до на екрана качеството чрез изостряне, вместо чрез разтягане. Използва малко повече батерия."
          }
        }
      }
    },
