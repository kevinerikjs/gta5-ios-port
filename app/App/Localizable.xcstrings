    "Drag up or down to set throttle, left or right for rudder. Helicopters keep their buttons.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drag up or down to set throttle, left or right for rudder. Helicopters keep their buttons."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nach oben oder unten ziehen für den Schub, nach links oder rechts für das Seitenruder. Hubschrauber behalten ihre Tasten."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Desliza arriba o abajo para la potencia y a izquierda o derecha para el timón. Los helicópteros mantienen sus botones."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desliza arriba o abajo para la potencia y a izquierda o derecha para el timón. Los helicópteros mantienen sus botones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Glissez vers le haut ou le bas pour les gaz, à gauche ou à droite pour la gouverne de direction. Les hélicoptères gardent leurs boutons."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trascina su o giù per la potenza, a sinistra o a destra per il timone. Gli elicotteri mantengono i loro pulsanti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "上下にドラッグでスロットル、左右でラダーを操作します。ヘリコプターはボタンのままです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "위아래로 드래그하면 추력, 좌우로 드래그하면 러더를 조절합니다. 헬리콥터는 버튼을 그대로 사용합니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przeciągnij w górę lub w dół, aby ustawić ciąg, w lewo lub w prawo dla steru kierunku. Helikoptery zachowują swoje przyciski."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Arraste para cima ou para baixo para a potência, para a esquerda ou direita para o leme. Helicópteros mantêm os botões."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ведите вверх или вниз для тяги, влево или вправо для руля направления. У вертолётов остаются кнопки."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "上下拖动控制油门，左右拖动控制方向舵。直升机仍使用按钮。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "上下拖曳控制油門，左右拖曳控制方向舵。直升機仍使用按鈕。"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Tortishish kuchini (gazni) sozlash uchun yuqoriga yoki pastga, rul uchun chapga yoki oʻngga suring. Vertolyotlar oʻz tugmalarini saqlab qoladi."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Плъзнете нагоре или надолу за да настроите газта, наляво или надясно за кормилото. На хеликоптерите бутоните си остават."
          }
        }
      }
    },
