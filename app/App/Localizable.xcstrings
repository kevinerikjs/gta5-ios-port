            "state": "translated",
            "value": " Закройте и снова откройте приложение, чтобы запустить {arg0}."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": " 关闭并重新打开 App，即可游玩 {arg0}。"
          }
        },
        "es-419": {
