        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pliki tylko w iCloud, a nie na tym iPhonie: {arg0} (np. {arg1}). Gra nie może ich stamtąd odczytać: przenieś folder gry do Pliki › Na moim iPhonie › GTA V Port."
          }
        },
