    "Open the Files app yourself and go to On My iPhone › GTA V Port, move your game folder there, then come back.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open the Files app yourself and go to On My iPhone › GTA V Port, move your game folder there, then come back."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne die Dateien-App selbst, geh zu Auf meinem iPhone › GTA V Port, verschiebe deinen Spielordner dorthin und komm zurück."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre tú mismo la app Archivos, ve a En mi iPhone › GTA V Port, mueve allí tu carpeta del juego y vuelve."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre tú mismo la app Archivos, ve a En mi iPhone › GTA V Port, mueve allí tu carpeta del juego y vuelve."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez vous-même l’app Fichiers, allez dans Sur mon iPhone › GTA V Port, déplacez-y votre dossier du jeu, puis revenez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apri tu l’app File, vai in Su iPhone › GTA V Port, sposta lì la cartella del gioco, poi torna qui."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「ファイル」アプリを自分で開き、「このiPhone内 › GTA V Port」へゲームフォルダを移動してから戻ってきてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파일 앱을 직접 열고 ‘나의 iPhone › GTA V Port’로 가서 게임 폴더를 옮긴 다음 돌아오세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Otwórz samodzielnie aplikację Pliki, przejdź do Na moim iPhonie › GTA V Port, przenieś tam folder gry i wróć."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra você mesmo o app Arquivos, vá em No Meu iPhone › GTA V Port, mova a pasta do jogo para lá e volte."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Откройте «Файлы» сами, перейдите в На iPhone › GTA V Port, переместите туда папку игры и вернитесь."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请自己打开“文件”App，前往“我的 iPhone › GTA V Port”，把游戏文件夹移到那里，然后回来。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請自行打開「檔案」App，前往「我的 iPhone › GTA V Port」，把遊戲資料夾搬到那裡，然後回來。"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "\"Fayllar\" ilovasini oʻzingiz oching va Mening iPhone’imda › GTA V Port manziliga oʻting, oʻyin papkasini u yerga koʻchiring va ilovaga qayting."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Отвори сам приложението Файлове/Files и отиди в На Моя iPhone/On My iPhone > GTA V Port, премести си играта там, и се върни."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dosyalar uygulamasını kendiniz açın ve On My iPhone › GTA V Port'a gidin, oyun klasörünüzü oraya taşıyın, ardından geri dönün."
          }
        }
      }
    },
    "Open didn't work?": {
      "extractionState": "manual",
      "localizations": {
