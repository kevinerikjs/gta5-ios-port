        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 사이트에서는 광고 차단이 꺼져 있습니다. 페이지의 다운로드 버튼을 다시 클릭하세요."
          }
        },
        "pl": {
