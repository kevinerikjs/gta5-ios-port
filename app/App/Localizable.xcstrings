    "{arg0} reacts to the key you pick instead of {arg1}: from a keyboard, the Mod keys tray or an on-screen button. Applies right away.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "{arg0} reacts to the key you pick instead of {arg1}: from a keyboard, the Mod keys tray or an on-screen button. Applies right away."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "{arg0} reagiert auf die gewählte Taste statt auf {arg1}: über eine Tastatur, die Mod-Tasten oder einen Bildschirm-Button. Gilt sofort."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "{arg0} responde a la tecla que elijas en lugar de {arg1}: desde un teclado, las Teclas de mods o un botón en pantalla. Se aplica al instante."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "{arg0} responde a la tecla que elijas en lugar de {arg1}: desde un teclado, las Teclas de mods o un botón en pantalla. Se aplica al instante."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "{arg0} réagit à la touche choisie au lieu de {arg1} : depuis un clavier, les Touches des mods ou un bouton à l’écran. S’applique tout de suite."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "{arg0} risponde al tasto scelto invece di {arg1}: da una tastiera, dai Tasti mod o da un pulsante sullo schermo. Vale subito."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "{arg0} は {arg1} の代わりに選んだキーに反応します（キーボード、Modキー、画面上のボタン）。すぐに反映されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "{arg0}는 {arg1} 대신 선택한 키에 반응합니다. 키보드, 모드 키, 화면 버튼 모두 해당되며 바로 적용됩니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "{arg0} reaguje na wybrany klawisz zamiast {arg1}: z klawiatury, Klawiszy modów lub przycisku na ekranie. Działa od razu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "{arg0} responde à tecla escolhida em vez de {arg1}: de um teclado, das Teclas de mods ou de um botão na tela. Vale na hora."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "{arg0} реагирует на выбранную клавишу вместо {arg1}: с клавиатуры, из Клавиш модов или с кнопки на экране. Работает сразу."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "{arg0} 会响应你选的按键，而不是 {arg1}：来自键盘、模组按键或屏幕按钮。立即生效。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "{arg0} 會回應你選的按鍵，而不是 {arg1}：來自鍵盤、模組按鍵或螢幕按鈕。立即生效。"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
