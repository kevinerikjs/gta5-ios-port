    "Please send the log so this can be fixed, then close the app and open it again to keep playing.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Please send the log so this can be fixed, then close the app and open it again to keep playing."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitte sende das Protokoll, damit das behoben werden kann. Schließe dann die App und öffne sie erneut, um weiterzuspielen."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Envía el registro para que esto se pueda arreglar; después cierra la app y vuelve a abrirla para seguir jugando."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Envía el registro para que esto se pueda arreglar; después cierra la app y vuelve a abrirla para seguir jugando."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Envoyez le journal pour que ce problème puisse être corrigé, puis fermez l’app et rouvrez-la pour continuer à jouer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Invia il registro così il problema può essere risolto, poi chiudi l’app e riaprila per continuare a giocare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "修正のためにログを送信してください。その後、アプリを閉じてもう一度開くとプレイを続けられます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "문제를 고칠 수 있도록 로그를 보내 주세요. 그런 다음 앱을 닫았다가 다시 열면 계속 플레이할 수 있습니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wyślij dziennik, żeby można było to naprawić, a potem zamknij aplikację i otwórz ją ponownie, aby grać dalej."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Envie o registro para que isso possa ser corrigido, depois feche o app e abra de novo para continuar jogando."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отправьте журнал, чтобы это можно было исправить, затем закройте приложение и откройте его снова, чтобы продолжить игру."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请发送日志以便修复此问题，然后关闭 App 并重新打开即可继续游玩。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請傳送紀錄以便修正此問題，然後關閉 App 再重新開啟即可繼續遊玩。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يرجى إرسال السجل حتى يمكن إصلاحه، ثم إغلاق التطبيق وفتحه مرة أخرى لمواصلة اللعب."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vui lòng gửi log để dev sửa lỗi, rồi đóng app và mở lại để chơi tiếp."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Muammoni hal qilishimiz uchun log-faylni yuboring, soʻngra oʻyinni davom ettirish uchun ilovani yopib, qayta oching."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Будь ласка, поширте логи, для того що би це могло бути виправлено, потім закрийте гру, і відкрийте її ще раз для того щоб продовжити грати."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Моля изпрати log, за да може да бъде оправено, след това затвори приложението и пак го отвори за да продължиш да играеш."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bunun düzeltilebilmesi için lütfen günlüğü gönderin, ardından uygulamayı kapatın ve oynamaya devam etmek için tekrar açın."
          }
        }
      }
    },
