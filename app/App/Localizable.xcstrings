        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Los archivos del juego ya están en este iPhone (carpeta \"{arg0}\"), así que no hace falta descargar nada."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Oʻyin fayllari allaqachon ushbu iPhone’da mavjud (\"{arg0}\" papkasi), shuning uchun hech narsa yuklab olish shart emas."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ملفات اللعبة موجودة بالفعل على جهاز iPhone هذا (في المجلد \"{arg0}\")، لذلك لا حاجة إلى تنزيل أي ملفات"
