    "Version {arg0} is out. You have {arg1}.\n\nThe new IPA is posted in the Releases topic of our Telegram group. Install it the same way you installed this one.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Version {arg0} is out. You have {arg1}.\n\nThe new IPA is posted in the Releases topic of our Telegram group. Install it the same way you installed this one."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Version {arg0} ist da. Du hast {arg1}.\n\nDie neue IPA ist im Releases-Thema unserer Telegram-Gruppe gepostet. Installiere sie genauso wie diese."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Ya está disponible la versión {arg0}. Tienes la {arg1}.\n\nLa nueva IPA está publicada en el tema Releases de nuestro grupo de Telegram. Instálala igual que instalaste esta."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ya está disponible la versión {arg0}. Tienes la {arg1}.\n\nLa nueva IPA está publicada en el tema Releases de nuestro grupo de Telegram. Instálala igual que instalaste esta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La version {arg0} est sortie. Vous avez la {arg1}.\n\nLa nouvelle IPA est publiée dans le sujet Releases de notre groupe Telegram. Installez-la comme vous avez installé celle-ci."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È uscita la versione {arg0}. Tu hai la {arg1}.\n\nLa nuova IPA è pubblicata nell’argomento Releases del nostro gruppo Telegram. Installala come hai installato questa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バージョン {arg0} が公開されました。現在のバージョンは {arg1} です。\n\n新しい IPA は Telegram グループの Releases トピックに投稿されています。このアプリと同じ方法でインストールしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "버전 {arg0}이(가) 나왔습니다. 현재 버전은 {arg1}입니다.\n\n새 IPA는 Telegram 그룹의 Releases 토픽에 올라와 있습니다. 이 앱을 설치한 것과 같은 방법으로 설치하세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wyszła wersja {arg0}. Masz {arg1}.\n\nNowa IPA jest w temacie Releases w naszej grupie na Telegramie. Zainstaluj ją tak samo jak tę."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A versão {arg0} saiu. Você tem a {arg1}.\n\nO novo IPA está no tópico Releases do nosso grupo no Telegram. Instale do mesmo jeito que instalou este."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вышла версия {arg0}. У вас {arg1}.\n\nНовый IPA опубликован в теме Releases нашей группы в Telegram. Установите его так же, как этот."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "版本 {arg0} 已发布。你当前的版本是 {arg1}。\n\n新的 IPA 已发布在 Telegram 群组的 Releases 话题中。请用安装此 App 的相同方式安装。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "版本 {arg0} 已推出。你目前的版本是 {arg1}。\n\n新的 IPA 已發布在 Telegram 群組的 Releases 話題中。請用安裝此 App 的相同方式安裝。"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "{arg0}-versiya chiqdi. Sizda {arg1}-versiya oʻrnatilgan.\n\nYangi IPA fayli Telegram guruhimizning “Releases” mavzusida joylashtirildi. Uni ham hozirgisini oʻrnatgan usulingizda oʻrnating."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Версия {arg0} излезе. Ти имаш {arg1}.\n\nНовият IPA файл е качен в Releases канала в Телеграм групата на Five Star Port. Инсталирай го по същия начин, по който инсталира този."
          }
        }
      }
    },
