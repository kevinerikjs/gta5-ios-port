            "value": "下载在 {arg0}% 处停止"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "下載在 {arg0}% 處停止"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Yuklash {arg0}% da toʻxtab qoldi"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Тегленето спря на {arg0}%"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İndirme {arg0}%'de durdu"
          }
        }
      }
    },
    "Tap Continue the download: it picks up where it stopped instead of starting again.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap Continue the download: it picks up where it stopped instead of starting again."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe auf „Download fortsetzen“: Er macht dort weiter, wo er aufgehört hat, statt von vorn zu beginnen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca Continuar la descarga: sigue donde se detuvo en lugar de empezar de nuevo."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca Continuar la descarga: sigue donde se detuvo en lugar de empezar de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touche Reprendre le téléchargement : il reprend là où il s’est arrêté au lieu de recommencer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca Riprendi il download: riparte da dove si era fermato invece di ricominciare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「ダウンロードを続ける」をタップすると、最初からではなく止まったところから再開します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다운로드 계속하기를 누르면 처음부터가 아니라 멈춘 곳부터 이어서 받습니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stuknij Wznów pobieranie: zacznie tam, gdzie się zatrzymało, zamiast od nowa."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque em Continuar o download: ele continua de onde parou em vez de começar de novo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите «Продолжить загрузку»: она продолжится с места остановки, а не начнётся заново."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点按“继续下载”:从停止的地方继续,而不是重新开始。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點按「繼續下載」:從停止的地方繼續,而不是重新開始。"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "\"Yuklab olishni davom ettirish\" tugmasini bosing: u boshidan boshlamay, toʻxtagan joyidan davom etadi."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Цъкни Продължи тегленето: продължава там откъдето спря, вместо да започва наново"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İndirmeye Devam Et'e dokunun: yeniden başlamak yerine durduğu yerden devam eder."
          }
        }
      }
    },
    "Tap Continue the download and pick the same archive: files already unpacked aren't unpacked again.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap Continue the download and pick the same archive: files already unpacked aren't unpacked again."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe auf „Download fortsetzen“ und wähle dasselbe Archiv: Bereits entpackte Dateien werden nicht noch einmal entpackt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca Continuar la descarga y elige el mismo archivo: lo que ya se descomprimió no se vuelve a descomprimir."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca Continuar la descarga y elige el mismo archivo: lo que ya se descomprimió no se vuelve a descomprimir."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touche Reprendre le téléchargement et choisis la même archive : les fichiers déjà décompressés ne le sont pas une seconde fois."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca Riprendi il download e scegli lo stesso archivio: i file già estratti non vengono estratti di nuovo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「ダウンロードを続ける」をタップして同じアーカイブを選んでください。展開済みのファイルは再展開しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다운로드 계속하기를 누르고 같은 압축 파일을 고르세요. 이미 푼 파일은 다시 풀지 않습니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stuknij Wznów pobieranie i wybierz to samo archiwum: rozpakowane już pliki nie są rozpakowywane ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque em Continuar o download e escolha o mesmo arquivo: o que já foi extraído não é extraído de novo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите «Продолжить загрузку» и выберите тот же архив: уже распакованные файлы не распаковываются снова."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点按“继续下载”并选择同一个压缩包:已解压的文件不会再次解压。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點按「繼續下載」並選擇同一個壓縮檔:已解壓的檔案不會再次解壓。"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "\"Yuklab olishni davom ettirish\" tugmasini bosing va oʻsha arxivni tanlang: allaqachon chiqarilgan fayllar qayta arxivdan chiqarilmaydi."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Цъкни Продължи тегленето и избери същия архив: файловете, които вече са разопаковани не се разопаковат пак."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İndirmeye devam et'e dokunun ve aynı arşivi seçin: zaten açılmış dosyalar tekrar açılmaz."
          }
        }
      }
    },
    "Cancelled. What was downloaded and unpacked is kept: Continue the download picks up where it stopped.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancelled. What was downloaded and unpacked is kept: Continue the download picks up where it stopped."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Abgebrochen. Was heruntergeladen und entpackt wurde, bleibt erhalten: „Download fortsetzen“ macht dort weiter."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancelado. Lo descargado y descomprimido se conserva: Continuar la descarga sigue donde se detuvo."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancelado. Lo descargado y descomprimido se conserva: Continuar la descarga sigue donde se detuvo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Annulé. Ce qui a été téléchargé et décompressé est conservé : Reprendre le téléchargement continue là où il s’est arrêté."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Annullato. Ciò che è stato scaricato ed estratto resta: Riprendi il download riparte da dove si era fermato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キャンセルしました。ダウンロード・展開済みの分は残ります。「ダウンロードを続ける」で止まったところから再開します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "취소했습니다. 받고 푼 부분은 남아 있으며, 다운로드 계속하기로 멈춘 곳부터 이어서 받습니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Anulowano. To, co pobrano i rozpakowano, zostaje: Wznów pobieranie zacznie tam, gdzie przerwało."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancelado. O que foi baixado e extraído fica guardado: Continuar o download segue de onde parou."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отменено. Скачанное и распакованное сохраняется: «Продолжить загрузку» продолжит с места остановки."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已取消。已下载和解压的内容会保留:“继续下载”会从停止的地方继续。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已取消。已下載和解壓的內容會保留:「繼續下載」會從停止的地方繼續。"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Bekor qilindi. Yuklab olingan va arxivdan chiqarilgan fayllar saqlab qolindi: \"Davom ettirish\" tugmasi yuklashni toʻxtagan joyidan davom ettiradi."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Отказано. Досега изтегленото и разопакованото остава: Продължаване на тегленето продължава там, където спря."
          }
        }
      }
    },
