    "The game didn't respond. Return to normal gameplay and try again.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The game didn't respond. Return to normal gameplay and try again."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Spiel hat nicht reagiert. Kehre zum normalen Spiel zurück und versuch es noch einmal."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El juego no respondió. Vuelve al juego normal e inténtalo de nuevo."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "El juego no respondió. Vuelve al juego normal e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le jeu n’a pas répondu. Revenez au jeu normal et réessayez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il gioco non ha risposto. Torna al gioco normale e riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ゲームが応答しませんでした。通常のプレイに戻ってから、もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "게임이 응답하지 않았습니다. 일반 플레이로 돌아가서 다시 시도하세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gra nie odpowiedziała. Wróć do zwykłej rozgrywki i spróbuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O jogo não respondeu. Volte ao jogo normal e tente de novo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Игра не ответила. Вернитесь к обычной игре и попробуйте снова."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "游戏没有响应。请回到正常游戏后再试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "遊戲沒有回應。請回到正常遊戲後再試。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم تستجب اللعبة. عد إلى طريقة اللعب العادية وحاول مرة أخرى."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Game ko phản hồi. Quay trở về gameplay bình thường và thử lại."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Oʻyin javob bermadi. Oddiy oʻyin rejimiga qayting va qaytadan urinib koʻring."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Гра не надала відповіді. Поверніться до звичайної гри, і спробуйте ще раз."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Играта не отговаря. Върни се в нормален геймплей и опитай отново"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oyun yanıt vermedi. Normal oyuna geri dönün ve tekrar deneyin."
          }
        }
      }
    },
