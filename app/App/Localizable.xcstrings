    "Switching tabs changes the camera control and the settings below. It does not force GTA V's in-game button prompt icons.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Switching tabs changes the camera control and the settings below. It does not force GTA V's in-game button prompt icons."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "切換分頁會改變鏡頭控制方式及下方設定；不會強制固定 GTA V 遊戲內的按鍵提示圖示。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "切换标签会改变镜头控制方式及下方设置；不会强制固定 GTA V 游戏内的按键提示图标。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タブを切り替えるとカメラ操作と下の設定が変わります。ゲーム内のボタン表示は固定されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "탭을 바꾸면 카메라 조작과 아래 설정이 바뀝니다. 게임 내 버튼 안내 아이콘은 고정되지 않습니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Tab wechselt Kamerasteuerung und Einstellungen, fixiert aber nicht die Tastenhinweise im Spiel."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Changer d’onglet modifie les commandes de caméra et leurs réglages, sans figer les icônes d’aide en jeu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La scheda cambia i comandi della visuale e le impostazioni, ma non blocca le icone dei tasti nel gioco."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambiar de pestaña modifica el control de cámara y sus ajustes; no fija los iconos de botones del juego."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambiar de pestaña modifica el control de cámara y sus ajustes; no fija los íconos de botones del juego."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Trocar de aba muda o controle da câmera e seus ajustes, mas não fixa os ícones de botões no jogo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вкладки меняют управление камерой и настройки, но не закрепляют внутриигровые подсказки кнопок."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przełączanie kart zmienia sterowanie kamerą i ustawienia, ale nie blokuje ikon przycisków w grze."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تغيير علامات التبويب يغيّر طريقة التحكم بالكاميرا والإعدادات الموجودة بالأسفل. لكنه لا يفرض تغيير أيقونات أزرار التوجيه التي تظهر داخل لعبة GTA V"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Boʻlimlarni almashtirish kamera boshqaruvi va pastdagi sozlamalarga taʼsir qiladi. Lekin bu GTA 5 ichidagi tugma ikonkalarini avtomatsiz oʻzgartirib qoʻymaydi."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Превключването на разделите променя управлението на камерата и настройките по-долу. Това не налага показването на иконите за бутони, вградени в GTA V."
          }
        }
      }
    },
