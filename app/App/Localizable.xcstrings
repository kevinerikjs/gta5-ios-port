    "Pick the weather, or go back to the game's own changing weather. Missions can change it.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pick the weather, or go back to the game's own changing weather. Missions can change it."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle das Wetter oder kehre zum wechselnden Wetter des Spiels zurück. Missionen können es ändern."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige el clima o vuelve al clima cambiante del propio juego. Las misiones pueden cambiarlo."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige el clima o vuelve al clima cambiante del propio juego. Las misiones pueden cambiarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez la météo, ou revenez à la météo changeante du jeu. Les missions peuvent la modifier."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli il meteo o torna al meteo variabile del gioco. Le missioni possono cambiarlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "天気を選ぶか、ゲーム本来の移り変わる天気に戻します。ミッションで変わることがあります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "날씨를 고르거나 게임 원래의 변하는 날씨로 되돌립니다. 미션이 날씨를 바꿀 수 있습니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz pogodę albo wróć do zmiennej pogody z gry. Misje mogą ją zmienić."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha o clima ou volte ao clima variável do próprio jogo. As missões podem mudá-lo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите погоду или верните обычную меняющуюся погоду игры. Миссии могут её изменить."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择天气，或恢复游戏自带的天气变化。任务可能会改变天气。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇天氣，或恢復遊戲自帶的天氣變化。任務可能會改變天氣。"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Ob-havoni tanlang yoki o‘yinning o‘zgarib turadigan tabiiy ob-havo rejimiga qayting. Missiyalar ob-havoni o‘zgartirishi mumkin."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Избери прогноза, или се върни в на играта променливата прогноза. Мисиите може да я променят."
          }
        }
      }
    },
