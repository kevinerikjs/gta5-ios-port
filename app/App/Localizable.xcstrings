    "Where the map sits. Changes apply the next time the game starts.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Where the map sits. Changes apply the next time the game starts."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wo die Karte sitzt. Änderungen gelten ab dem nächsten Spielstart."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Dónde aparece el mapa. Los cambios se aplican la próxima vez que inicies el juego."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dónde aparece el mapa. Los cambios se aplican la próxima vez que inicies el juego."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’emplacement de la carte. Les changements s’appliquent au prochain lancement du jeu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dove si trova la mappa. Le modifiche valgono dal prossimo avvio del gioco."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マップの位置です。変更は次回のゲーム起動時に反映されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지도가 표시되는 위치입니다. 변경 사항은 다음에 게임을 시작할 때 적용됩니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gdzie jest mapa. Zmiany działają od następnego uruchomienia gry."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Onde o mapa fica. As mudanças valem a partir da próxima vez que o jogo iniciar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Где находится карта. Изменения вступят в силу при следующем запуске игры."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "地图显示的位置。更改将在下次启动游戏时生效。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "地圖顯示的位置。變更會在下次啟動遊戲時生效。"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Xaritaning ekrandagi joylashuvi. Oʻzgarishlar oʻyin qayta ishga tushirilganda kuchga kiradi."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Където седи картата. Промените се запазват следващия път като играта стартира."
          }
        }
      }
    },
