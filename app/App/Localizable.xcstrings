    "\"{arg0}\" is in save slot {arg1}. Start Story mode, then load it: Pause › Game › Load Game.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "\"{arg0}\" is in save slot {arg1}. Start Story mode, then load it: Pause › Game › Load Game."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„{arg0}“ ist in Speicherplatz {arg1}. Starte den Story-Modus und lade ihn: Pause › Spiel › Spiel laden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«{arg0}» está en el hueco {arg1}. Inicia el modo historia y cárgala: Pausa › Juego › Cargar partida."
          }
