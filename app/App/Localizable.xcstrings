    "Loading the vehicle took too long. Try again in an open area.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Loading the vehicle took too long. Try again in an open area."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Laden des Fahrzeugs hat zu lange gedauert. Versuch es an einer offenen Stelle noch einmal."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La carga del vehículo tardó demasiado. Vuelve a intentarlo en una zona abierta."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "La carga del vehículo tardó demasiado. Vuelve a intentarlo en una zona abierta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le chargement du véhicule a pris trop de temps. Réessayez dans un endroit dégagé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il caricamento del veicolo ha richiesto troppo tempo. Riprova in una zona aperta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "車両の読み込みに時間がかかりすぎました。開けた場所でもう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "차량을 불러오는 데 너무 오래 걸렸습니다. 트인 곳에서 다시 시도하세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wczytywanie pojazdu trwało za długo. Spróbuj ponownie w otwartym miejscu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O veículo demorou demais para carregar. Tente de novo em uma área aberta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Транспорт загружался слишком долго. Попробуйте ещё раз на открытом месте."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "载具加载时间过长。请在开阔的地方再试一次。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "載具載入時間過長。請在開闊的地方再試一次。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استغرق تحميل السيارة وقتا طويلاً جداً، حاول مرة أخرى في منطقة مفتوحة."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Load xe mất quá nhiều thời gian. Thử lại trong một nơi rộng rãi."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Transportni yuklash uzoq vaqt oldi. Ochiq joyda qayta urinib koʻring."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Завантаження транспорту зайняло забагато часу. Спробуйте ще раз в більш вільному середовищі."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aracın yüklenmesi çok uzun sürdü. Açık bir alanda tekrar deneyin."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Зареждането на превозното средство отне твърде дълго. Опитай пак на отворено пространство."
          }
        }
      }
    },
    "Not enough free memory to spawn it safely. Go somewhere quieter, or restart with a lower graphics preset.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not enough free memory to spawn it safely. Go somewhere quieter, or restart with a lower graphics preset."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicht genug freier Speicher, um es sicher erscheinen zu lassen. Geh an einen ruhigeren Ort oder starte mit einer niedrigeren Grafikvoreinstellung neu."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay suficiente memoria libre para hacerlo aparecer con seguridad. Ve a un lugar más tranquilo o reinicia con un preajuste gráfico más bajo."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay suficiente memoria libre para hacerlo aparecer con seguridad. Ve a un lugar más tranquilo o reinicia con un preajuste gráfico más bajo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas assez de mémoire libre pour le faire apparaître sans risque. Allez dans un endroit plus calme, ou redémarrez avec un préréglage graphique plus bas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non c’è abbastanza memoria libera per generarlo in sicurezza. Spostati in un posto più tranquillo o riavvia con un preset grafico più basso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "安全に出すための空きメモリが足りません。静かな場所に移動するか、低いグラフィックプリセットで再起動してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "안전하게 소환할 여유 메모리가 부족합니다. 더 한적한 곳으로 가거나 더 낮은 그래픽 프리셋으로 다시 시작하세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Za mało wolnej pamięci, żeby bezpiecznie go przywołać. Przejdź w spokojniejsze miejsce albo uruchom ponownie z niższym ustawieniem grafiki."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não há memória livre suficiente para gerá-lo com segurança. Vá para um lugar mais tranquilo ou reinicie com uma predefinição gráfica mais baixa."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Недостаточно свободной памяти, чтобы безопасно его вызвать. Отправляйтесь в место потише или перезапустите игру с более низким графическим пресетом."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可用内存不足，无法安全生成。请去人少一点的地方，或用更低的画质预设重新启动。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "可用記憶體不足，無法安全生成。請去人少一點的地方，或用更低的畫質預設重新啟動。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ko đủ bộ nhớ ram để triệu hồi an toàn. Đi tìm một chỗ nào đó yên tĩnh hơn, hoặc khởi động lại game với đồ hoạ thấp."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Obektni xavfsiz paydo qilish uchun xotira yetmayapti. Tinchroq joyga oʻting yoki grafikani pasaytirib, qayta kiring."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Недостатньо памʼяті для безпечного спавну. Переміститься в менш завантажене місце, або перезапустить гру з нижчими налаштуваннями графіки."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا توجد ذاكرة كافية لإنشاء هذا العنصر بأمان. انتقل إلى مكان أقل ازدحامًا، أو أعد تشغيل اللعبة باستخدام إعدادات رسومات أقل"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Güvenli bir şekilde ortaya çıkacak kadar boş bellek yok. Daha sessiz bir yere gidin veya daha düşük bir grafik ön ayarıyla yeniden başlatın."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Няма достатъчно памет за да се създаде. Отиди някъде по-празно, или рестартирай с по-ниски графики."
          }
        }
      }
    },
    "Both menu vehicles are in use. Leave one empty, then try again.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Both menu vehicles are in use. Leave one empty, then try again."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beide Menüfahrzeuge sind besetzt. Lass eines leer und versuch es dann noch einmal."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los dos vehículos del menú están ocupados. Deja uno vacío y vuelve a intentarlo."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Los dos vehículos del menú están ocupados. Deja uno vacío y vuelve a intentarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les deux véhicules du menu sont occupés. Laissez-en un vide, puis réessayez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Entrambi i veicoli del menu sono occupati. Lasciane uno vuoto, poi riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メニューの車両が2台とも使用中です。1台を空けてから、もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "메뉴 차량 두 대가 모두 사용 중입니다. 한 대를 비운 뒤 다시 시도하세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Oba pojazdy z menu są zajęte. Zostaw jeden pusty i spróbuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os dois veículos do menu estão ocupados. Deixe um vazio e tente de novo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Оба транспорта из меню заняты. Освободите один и попробуйте снова."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "菜单生成的两辆载具都有人在用。空出一辆后再试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選單生成的兩輛載具都有人在用。空出一輛後再試。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cả hai menu xe đang được sử dụng. Để trống một cái rồi thử lại."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Har ikkala menyu transporti band. Birtasini boʻsh qoldirib, qaytadan urinib koʻring."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Використовуються оби два меню транспорту. Залишіть одне пустим, і спробуйте ще раз."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her iki menü aracı da kullanımda. Birini boş bırakın, sonra tekrar deneyin."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "И двете превозни средства в менюто се използват. Остави едно празно и опитай пак."
          }
        }
      }
    },
