    "{arg0} comes from the mod {arg1}, made for GTA V Enhanced or a newer update. This game can't load it: switch the mod off.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "{arg0} comes from the mod {arg1}, made for GTA V Enhanced or a newer update. This game can't load it: switch the mod off."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "{arg0} stammt aus dem Mod {arg1}, gemacht für GTA V Enhanced oder ein neueres Update. Dieses Spiel kann es nicht laden: schalte den Mod aus."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "{arg0} viene del mod {arg1}, hecho para GTA V Enhanced o una actualización más reciente. Este juego no puede cargarlo: desactiva el mod."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "{arg0} viene del mod {arg1}, hecho para GTA V Enhanced o una actualización más reciente. Este juego no puede cargarlo: desactiva el mod."
