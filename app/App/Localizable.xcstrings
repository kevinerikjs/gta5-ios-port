    "Paused because this iPhone is almost out of storage.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Paused because this iPhone is almost out of storage."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "手機儲存空間即將耗盡，已暫停下載。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En pause : cet iPhone n’a presque plus de stockage."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In pausa perché questo iPhone ha quasi esaurito lo spazio."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pausiert, weil der Speicher dieses iPhone fast voll ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En pausa porque este iPhone casi no tiene almacenamiento libre."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このiPhoneのストレージがほぼいっぱいのため、一時停止しました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 iPhone의 저장 공간이 거의 가득 차서 일시 정지되었습니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wstrzymano, bo na tym iPhonie prawie zabrakło miejsca."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pausado porque o armazenamento deste iPhone está quase cheio."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пауза: на этом iPhone почти не осталось места."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone 存储空间即将用完，已暂停下载。"
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "En pausa porque este iPhone casi no tiene almacenamiento libre."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tạm dừng vì iPhone này gần hết dung lượng bộ nhớ trong."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Ushbu iPhone’da xotira deyarli toʻlgani sababli pauza qilindi"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم إيقاف التنزيل مؤقتًا لأن مساحة التخزين المتوفرة على جهاز iPhone هذا أوشكت على النفاد"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "На пауза, защото този iPhone почти няма място за съхранение."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu iPhone'un depolama alanı neredeyse tükendiği için duraklatıldı."
          }
        }
      }
    },
