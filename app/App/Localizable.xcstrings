    "Nothing can hurt you until you switch it off. Off again when the app restarts.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing can hurt you until you switch it off. Off again when the app restarts."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nichts kann dir schaden, bis du es ausschaltest. Nach einem Neustart der App wieder aus."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada puede hacerte daño hasta que lo desactives. Se desactiva al reiniciar la app."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada puede hacerte daño hasta que lo desactives. Se desactiva al reiniciar la app."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien ne peut vous blesser tant que vous ne le désactivez pas. Désactivé à nouveau au redémarrage de l’app."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Niente può ferirti finché non lo disattivi. Torna disattivato quando riavvii l’app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オフにするまで一切ダメージを受けません。アプリを再起動するとオフに戻ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "끌 때까지 어떤 피해도 입지 않습니다. 앱을 다시 시작하면 다시 꺼집니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nic nie może cię zranić, dopóki tego nie wyłączysz. Po ponownym uruchomieniu aplikacji znów wyłączone."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada pode te ferir até você desligar. Volta a ficar desligado quando o app reinicia."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ничто не может вам навредить, пока вы это не выключите. После перезапуска приложения снова выключено."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在你关闭之前，任何东西都伤不到你。重新启动 App 后会恢复关闭。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在你關閉之前，任何東西都傷不到你。重新啟動 App 後會恢復關閉。"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "O‘chirmaguningizcha hech narsa sizga zarar yetkaza olmaydi. Ilova qayta ishga tushirilganda bu rejim avtomatik o‘chadi."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Нищо не може да те нарани, докато не го изключиш. Изключва се като приложението се рестартира."
          }
        }
      }
    },
