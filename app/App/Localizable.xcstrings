    "For iPhones with little memory: lower detail and draw distance, so the world keeps loading": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For iPhones with little memory: lower detail and draw distance, so the world keeps loading"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für iPhones mit wenig Speicher: weniger Details und Sichtweite, damit die Welt weiter lädt"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para iPhone con poca memoria: menos detalle y distancia de dibujado, para que el mundo siga cargando"
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Para iPhone con poca memoria: menos detalle y distancia de dibujado, para que el mundo siga cargando"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour les iPhone avec peu de mémoire : moins de détails et de distance d’affichage, pour que le monde continue de se charger"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per iPhone con poca memoria: meno dettagli e distanza visiva, così il mondo continua a caricarsi"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メモリが少ないiPhone向け：詳細と描画距離を下げ、ワールドの読み込みを続けます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "메모리가 적은 iPhone용: 디테일과 시야 거리를 낮춰 월드가 계속 로드됩니다"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dla iPhone’ów z małą ilością pamięci: mniej szczegółów i krótszy zasięg widzenia, by świat dalej się wczytywał"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para iPhones com pouca memória: menos detalhes e distância de visão, para o mundo continuar carregando"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для iPhone с малым объёмом памяти: меньше деталей и дальности прорисовки, чтобы мир продолжал загружаться"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "适用于内存较小的 iPhone：降低细节和绘制距离，让世界持续加载"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "適用於記憶體較小的 iPhone：降低細節與繪製距離，讓世界持續載入"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Xotirasi kam bo‘lgan iPhone’lar uchun: tafsilotlar darajasi va chizish masofasini pasaytiring, shunda dunyo yuklanishda davom etadi."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "За iPhone моделите с по-малка памет: намали детайли и дистанцията на изобразяване, за да продължава да се зарежда света."
          }
        }
      }
    },
    "Skip mission or other option (X)": {
