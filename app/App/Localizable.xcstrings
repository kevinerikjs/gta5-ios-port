    "Tap it while moving to sprint until you let go of the stick; hold it to open a parachute. Holding the stick at its edge sprints too.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap it while moving to sprint until you let go of the stick; hold it to open a parachute. Holding the stick at its edge sprints too."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe sie beim Laufen an, um zu sprinten, bis du den Stick loslässt; halte sie gedrückt, um einen Fallschirm zu öffnen. Den Stick bis zum Rand zu drücken, lässt dich ebenfalls sprinten."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Tócalo mientras te mueves para correr hasta que sueltes el stick; mantenlo presionado para abrir el paracaídas. Llevar el stick hasta el borde también te hace correr."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tócalo mientras te mueves para correr hasta que sueltes el stick; mantenlo pulsado para abrir el paracaídas. Llevar el stick hasta el borde también te hace correr."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez-le en vous déplaçant pour sprinter jusqu’à ce que vous relâchiez le stick ; maintenez-le pour ouvrir un parachute. Pousser le stick jusqu’au bord fait aussi sprinter."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Toccalo mentre ti muovi per scattare finché non lasci la levetta; tienilo premuto per aprire il paracadute. Anche spingere la levetta fino al bordo fa scattare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "移動中にタップすると、スティックを離すまでダッシュします。長押しでパラシュートを開きます。スティックを端まで倒してもダッシュします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이동 중에 탭하면 스틱에서 손을 뗄 때까지 달립니다. 길게 누르면 낙하산을 펼칩니다. 스틱을 끝까지 밀어도 달립니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stuknij go w ruchu, aby biec sprintem, dopóki nie puścisz drążka; przytrzymaj, aby otworzyć spadochron. Wychylenie drążka do krawędzi też uruchamia sprint."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque nele enquanto se move para correr até soltar o direcional; segure para abrir o paraquedas. Levar o direcional até a borda também faz correr."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите её во время движения, чтобы бежать, пока не отпустите стик; удерживайте, чтобы раскрыть парашют. Стик, отведённый до края, тоже включает бег."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "移动时轻点即可冲刺，直到松开摇杆；按住可打开降落伞。把摇杆推到边缘也会冲刺。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "移動時點按即可衝刺，直到放開搖桿；按住可打開降落傘。把搖桿推到邊緣也會衝刺。"
          }
        }
      }
    },
